# Configuración de Apartamento Pre-seleccionado
# Si deseas crear una app específica para un solo apartamento, 
# descomenta y configura VITE_APARTMENT con uno de los siguientes valores:
# - ibarra: Para Capricho de Ibarra
# - quevedo: Para Capricho de Quevedo
# 
# Si no se configura, la app mostrará la pantalla de selección de apartamento

# VITE_APARTMENT=ibarra
# VITE_APARTMENT=quevedo
